{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/copywrite-ai/ortm/benchmarks/schema/offline-scenario.schema.json",
  "title": "ORTM offline codec benchmark scenario",
  "type": "object",
  "required": ["name", "video", "marker", "cases"],
  "properties": {
    "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
    "description": { "type": "string" },
    "matrix": { "type": "object" },
    "video": {
      "type": "object",
      "required": ["width", "height", "fps", "frames", "bitrate_kbps", "key_int"],
      "properties": {
        "codec": { "enum": ["h264", "vp8", "vp9", "av1"] },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "fps": { "type": "integer", "minimum": 1 },
        "frames": { "type": "integer", "minimum": 1 },
        "bitrate_kbps": { "type": "integer", "minimum": 1 },
        "key_int": { "type": "integer", "minimum": 1 },
        "preset": { "type": "string" }
      },
      "additionalProperties": false
    },
    "marker": {
      "type": "object",
      "required": ["cell", "padding", "background_alpha", "cell_alpha"],
      "properties": {
        "x": { "type": "integer", "minimum": 0 },
        "y": { "type": "integer", "minimum": 0 },
        "cell": { "type": "integer", "minimum": 1 },
        "padding": { "type": "integer", "minimum": 0 },
        "background_alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "cell_alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "border_alpha": { "type": "number", "minimum": 0, "maximum": 1 },
        "finder_layout": { "enum": ["four", "three", "two-top"] },
        "frame_seq_start": { "type": "integer", "minimum": 0, "maximum": 65535 },
        "timestamp_start_ms": { "type": "integer", "minimum": 0, "maximum": 4294967295 }
      },
      "additionalProperties": false
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "background"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*$" },
          "background": { "enum": ["flat", "stripes", "moving-checker", "snow"] }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
